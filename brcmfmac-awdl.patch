+// SPDX-License-Identifier: ISC
+/* AWDL (Apple Wireless Direct Link) support for brcmfmac.
+ *
+ * Apple's Broadcom firmware implements AWDL timing/sync/channel hopping in
+ * the dongle. The host creates an AWDL bsscfg with the "awdl_if" iovar, the
+ * firmware answers with a WLC_E_IF event (role 7). We attach a netdev
+ * (awdl%d, iftype OCB) to it and forward AWDL firmware events plus action
+ * frames received on that interface to userspace as nl80211 vendor events.
+ */
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <net/cfg80211.h>
+#include <net/netlink.h>
+
+#include "core.h"
+#include "debug.h"
+#include "fweh.h"
+#include "cfg80211.h"
+#include "vendor.h"
+#include "awdl.h"
+
+bool brcmf_awdl_is_awdl_if(struct brcmf_if *ifp)
+{
+	return ifp && ifp->vif && ifp->vif->wdev.iftype == NL80211_IFTYPE_OCB;
+}
+
+int brcmf_awdl_notify_fwevent(struct brcmf_if *ifp,
+			      const struct brcmf_event_msg *e, void *data)
+{
+	struct brcmf_cfg80211_info *cfg = ifp->drvr->config;
+	struct wiphy *wiphy = cfg_to_wiphy(cfg);
+	struct wireless_dev *wdev = NULL;
+	struct brcmf_vndr_fwevent_hdr hdr;
+	struct sk_buff *skb;
+	u32 datalen = e->datalen;
+
+	if (datalen > BRCMF_DCMD_MAXLEN)
+		datalen = BRCMF_DCMD_MAXLEN;
+
+	if (ifp->vif && ifp->vif->wdev.netdev &&
+	    ifp->vif->wdev.netdev->reg_state == NETREG_REGISTERED)
+		wdev = &ifp->vif->wdev;
+
+	hdr.event_code = cpu_to_le32(e->event_code);
+	hdr.status = cpu_to_le32(e->status);
+	hdr.reason = cpu_to_le32(e->reason);
+	hdr.flags = cpu_to_le32(e->flags);
+	hdr.ifidx = cpu_to_le32(e->ifidx);
+	hdr.bsscfgidx = cpu_to_le32(e->bsscfgidx);
+	memcpy(hdr.addr, e->addr, ETH_ALEN);
+	hdr.datalen = cpu_to_le16(datalen);
+
+	skb = cfg80211_vendor_event_alloc(wiphy, wdev,
+					  sizeof(hdr) + datalen + 32,
+					  BRCMF_VNDR_EVT_FWEVENT, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	if (nla_put(skb, BRCMF_NLATTR_FWEVENT_HDR, sizeof(hdr), &hdr) ||
+	    (datalen && nla_put(skb, BRCMF_NLATTR_FWEVENT_DATA, datalen, data))) {
+		kfree_skb(skb);
+		return -ENOBUFS;
+	}
+	cfg80211_vendor_event(skb, GFP_KERNEL);
+	brcmf_dbg(EVENT, "awdl: forwarded fw event %u status %u ifidx %u len %u\n",
+		  e->event_code, e->status, e->ifidx, datalen);
+	return 0;
+}
+
+/* Called from the WLC_E_IF handler for an unsolicited IF_ADD with the AWDL
+ * role: give the new ifp a vif and a registered netdev.
+ */
+int brcmf_awdl_attach_if(struct brcmf_cfg80211_info *cfg, struct brcmf_if *ifp)
+{
+	struct brcmf_cfg80211_vif *vif;
+	int err;
+
+	vif = brcmf_alloc_vif(cfg, NL80211_IFTYPE_OCB);
+	if (IS_ERR(vif))
+		return PTR_ERR(vif);
+
+	ifp->vif = vif;
+	vif->ifp = ifp;
+	if (ifp->ndev) {
+		vif->wdev.netdev = ifp->ndev;
+		ifp->ndev->ieee80211_ptr = &vif->wdev;
+		SET_NETDEV_DEV(ifp->ndev, wiphy_dev(cfg->wiphy));
+	}
+
+	err = brcmf_net_attach(ifp, false);
+	if (err) {
+		bphy_err(cfg->pub, "awdl: net attach failed %d\n", err);
+		ifp->vif = NULL;
+		brcmf_free_vif(vif);
+		return err;
+	}
+	ifp->ndev->needed_headroom += BRCMF_AWDL_ENCAP_LEN;
+	brcmf_dbg(INFO, "awdl: attached %s bsscfg %d ifidx %d\n",
+		  ifp->ndev->name, ifp->bsscfgidx, ifp->ifidx);
+	return 0;
+}
+
+void brcmf_awdl_register_event_handlers(struct brcmf_cfg80211_info *cfg)
+{
+	static const enum brcmf_fweh_event_code codes[] = {
+		BRCMF_E_AWDL_AW, BRCMF_E_AWDL_ROLE, BRCMF_E_AWDL_EVENT,
+		BRCMF_E_AWDL_AW_EXT_END, BRCMF_E_AWDL_AW_EXT_START,
+		BRCMF_E_AWDL_AW_START, BRCMF_E_AWDL_RADIO_OFF,
+		BRCMF_E_AWDL_PEER_STATE, BRCMF_E_AWDL_SYNC_STATE_CHANGED,
+		BRCMF_E_AWDL_CHIP_RESET, BRCMF_E_AWDL_INTERLEAVED_SCAN_START,
+		BRCMF_E_AWDL_INTERLEAVED_SCAN_STOP,
+		BRCMF_E_AWDL_PEER_CACHE_CONTROL,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(codes); i++)
+		brcmf_fweh_register(cfg->pub, codes[i],
+				    brcmf_awdl_notify_fwevent);
+}
+
+/* AWDL data frames on the air are 802.3 + LLC/SNAP (Apple OUI 00:17:f2, PID
+ * 0x0800) + a 6-byte AWDL data header {0x03,0x04, seq le16, 0x00,0x00} + the
+ * real ethertype. Apple's awdl0 hides this; do the same so the Linux IP stack
+ * sees plain Ethernet II frames.
+ */
+static const u8 brcmf_awdl_snap[8] = { 0xaa, 0xaa, 0x03, 0x00, 0x17, 0xf2, 0x08, 0x00 };
+static u16 brcmf_awdl_tx_seq;
+static int brcmf_awdl_txencap = 1;
+module_param_named(awdl_txencap, brcmf_awdl_txencap, int, 0644);
+MODULE_PARM_DESC(awdl_txencap, "Add LLC/SNAP+AWDL header on awdl0 TX (1) or send Ethernet II (0)");
+static int brcmf_awdl_rxdecap = 1;
+module_param_named(awdl_rxdecap, brcmf_awdl_rxdecap, int, 0644);
+MODULE_PARM_DESC(awdl_rxdecap, "Strip LLC/SNAP+AWDL header on awdl0 RX");
+
+/* We cannot sniff our own radio, so the only way to learn the on-air format of the
+ * data frames a peer sends us is to count what arrives: frames that carry the Apple
+ * LLC/SNAP + AWDL data header vs frames that are already plain Ethernet II. Exposed
+ * read-only so a test run can read them without a debug build:
+ *   /sys/module/brcmfmac/parameters/awdl_rx_encapped | awdl_rx_plain
+ */
+static int brcmf_awdl_rx_encapped;
+module_param_named(awdl_rx_encapped, brcmf_awdl_rx_encapped, int, 0644);
+MODULE_PARM_DESC(awdl_rx_encapped, "awdl0 RX frames that carried the LLC/SNAP+AWDL header");
+static int brcmf_awdl_rx_plain;
+module_param_named(awdl_rx_plain, brcmf_awdl_rx_plain, int, 0644);
+MODULE_PARM_DESC(awdl_rx_plain, "awdl0 RX frames that were already plain Ethernet II");
+
+int brcmf_awdl_tx_encap(struct brcmf_if *ifp, struct sk_buff *skb)
+{
+	u8 *p;
+	__be16 proto;
+	u16 seq;
+
+	if (!brcmf_awdl_txencap)
+		return 0;
+	if (skb->len < ETH_HLEN)
+		return -EINVAL;
+	if (skb_headroom(skb) < BRCMF_AWDL_ENCAP_LEN || skb_header_cloned(skb)) {
+		if (pskb_expand_head(skb, BRCMF_AWDL_ENCAP_LEN, 0, GFP_ATOMIC))
+			return -ENOMEM;
+	}
+	proto = ((struct ethhdr *)skb->data)->h_proto;
+	p = skb_push(skb, BRCMF_AWDL_ENCAP_LEN);
+	memmove(p, p + BRCMF_AWDL_ENCAP_LEN, 2 * ETH_ALEN);
+	*(__be16 *)(p + 12) = htons(skb->len - ETH_HLEN);	/* 802.3 length */
+	memcpy(p + 14, brcmf_awdl_snap, sizeof(brcmf_awdl_snap));
+	seq = brcmf_awdl_tx_seq++;
+	p[22] = 0x03; p[23] = 0x04;
+	p[24] = seq & 0xff; p[25] = seq >> 8;
+	p[26] = 0; p[27] = 0;
+	*(__be16 *)(p + 28) = proto;
+	skb_reset_mac_header(skb);
+	return 0;
+}
+
+/* called with skb->data just past the 14-byte MAC header (after eth_type_trans) */
+void brcmf_awdl_rx_decap(struct brcmf_if *ifp, struct sk_buff *skb)
+{
+	u8 *d = skb->data;
+	__be16 proto;
+
+	if (skb->len < BRCMF_AWDL_ENCAP_LEN ||
+	    memcmp(d, brcmf_awdl_snap, sizeof(brcmf_awdl_snap)) != 0 ||
+	    d[8] != 0x03 || d[9] != 0x04) {
+		brcmf_awdl_rx_plain++;
+		brcmf_dbg(DATA, "awdl: rx plain %*ph\n",
+			  min_t(int, skb->len, 16), skb->data);
+		return;
+	}
+	brcmf_awdl_rx_encapped++;
+	if (!brcmf_awdl_rxdecap)
+		return;
+	proto = *(__be16 *)(d + 14);
+	/* Move the Ethernet addresses up over the encapsulation instead of only
+	 * pulling: AF_PACKET taps (tcpdump) rebuild the frame from skb_mac_header()
+	 * to the tail, so a plain skb_pull() would leave the 16 stale header bytes
+	 * sitting between the MAC header and the IP header in every capture.
+	 */
+	if (skb_mac_header_was_set(skb)) {
+		u8 *mac = skb_mac_header(skb);
+
+		memmove(mac + BRCMF_AWDL_ENCAP_LEN, mac, 2 * ETH_ALEN);
+		skb_pull(skb, BRCMF_AWDL_ENCAP_LEN);
+		skb_set_mac_header(skb, -ETH_HLEN);
+		*(__be16 *)(skb_mac_header(skb) + 12) = proto;
+	} else {
+		skb_pull(skb, BRCMF_AWDL_ENCAP_LEN);
+	}
+	skb->protocol = proto;
+}
