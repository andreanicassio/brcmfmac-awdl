+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/awdl.h	2026-09-11 23:35:42.638924536 +0100
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: ISC
+/* AWDL (Apple Wireless Direct Link) support: expose the firmware's built-in
+ * AWDL engine to userspace. Experimental.
+ */
+#ifndef _awdl_h_
+#define _awdl_h_
+
+struct brcmf_if;
+struct brcmf_event_msg;
+struct brcmf_cfg80211_info;
+
+int brcmf_awdl_notify_fwevent(struct brcmf_if *ifp,
+			      const struct brcmf_event_msg *e, void *data);
+int brcmf_awdl_attach_if(struct brcmf_cfg80211_info *cfg, struct brcmf_if *ifp);
+void brcmf_awdl_register_event_handlers(struct brcmf_cfg80211_info *cfg);
+bool brcmf_awdl_is_awdl_if(struct brcmf_if *ifp);
+
+#endif /* _awdl_h_ */
